// Color Hunt — schéma Prisma (MySQL)
// Cf. cahier des charges §3 (schéma de données)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────────────────
// Statuts (cf. §6 du cahier des charges) :
//   ACTIVE       — compte actif (par défaut)
//   DEPART       — départ en cours (statut 4)
//   DESACTIVATE  — désactivé (statut 5)
//   SUPPRIME     — supprimé (statut 3)
enum UserStatus {
  ACTIVE
  DEPART
  DESACTIVATE
  SUPPRIME
}

// Statuts de demande (suppression) :
//   NONE       — aucune demande
//   EN_COURS   — demande en cours (statut 2)
//   VALIDEE    — demande validée (statut 1)
enum DemandStatus {
  NONE
  EN_COURS
  VALIDEE
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  pseudo           String       @unique
  passwordHash     String
  status           UserStatus   @default(ACTIVE)
  demandStatus     DemandStatus @default(NONE)
  isProfilePrivate Boolean      @default(false)
  avatarUrl        String?
  city             String?
  cameraModel      String?      @db.VarChar(120)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  createdGames       Game[]            @relation("GameCreator")
  participants       GameParticipant[]
  photos             Photo[]
  grids              Grid[]
  refreshTokens      RefreshToken[]
  sentFriendships    Friendship[]      @relation("FriendshipSender")
  receivedFriendships Friendship[]     @relation("FriendshipReceiver")
  sentMessages       DirectMessage[]   @relation("DMSender")
  receivedMessages   DirectMessage[]   @relation("DMReceiver")
  gridLikes          GridLike[]
  gridComments       GridComment[]
  gridCommentLikes   GridCommentLike[]
  notifications      Notification[]
  triggeredNotifs    Notification[]    @relation("NotificationActor")
  pushSubscriptions  PushSubscription[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── GAMES (chasses) ────────────────────────────────────────────────
enum GameMode {
  SOLO
  TEAM
}

enum GameVisibility {
  PUBLIC
  PRIVATE
}

enum GameStatus {
  LOBBY
  RUNNING
  FINISHED
  CANCELLED
}

enum GridVisibility {
  PUBLIC
  PRIVATE
}

model Game {
  id            String         @id @default(cuid())
  inviteCode    String         @unique @db.VarChar(8)
  creatorId     String
  creator       User           @relation("GameCreator", fields: [creatorId], references: [id])
  mode          GameMode       @default(SOLO)
  teamSize      Int            @default(2) // joueurs par équipe
  numTeams      Int            @default(2) // nombre d'équipes (mode TEAM uniquement)
  maxPlayers    Int            @default(6)
  durationMin   Int            @default(1440) // minutes
  visibility    GameVisibility @default(PRIVATE)
  status        GameStatus     @default(LOBBY)
  startedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())

  participants GameParticipant[]
  teams        Team[]
  photos       Photo[]
  grids        Grid[]

  @@index([inviteCode])
  @@index([status])
}

model Team {
  id               String  @id @default(cuid())
  gameId           String
  game             Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name             String
  assignedColorHex String  @db.VarChar(7)
  assignedColorName String

  participants GameParticipant[]

  @@index([gameId])
}

model GameParticipant {
  id              String   @id @default(cuid())
  gameId          String
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Couleur individuelle (mode solo). En mode équipe, on s'appuie sur Team.assignedColor.
  colorHex        String?  @db.VarChar(7)
  colorName       String?
  joinedAt        DateTime @default(now())

  @@unique([gameId, userId])
  @@index([gameId])
}

// ─── PHOTOS ─────────────────────────────────────────────────────────
model Photo {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId             String
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cloudinaryUrl      String   @db.VarChar(512)
  cloudinaryPublicId String   @db.VarChar(255)
  takenAt            DateTime?
  isSelectedForGrid  Boolean     @default(false)
  gridPosition       Int?        // 0-8 (3x3)
  createdAt          DateTime    @default(now())
  gridPhotos         GridPhoto[]

  @@index([gameId, userId])
  @@index([gameId, isSelectedForGrid])
}

// ─── GRILLES ────────────────────────────────────────────────────────
model Grid {
  id         String         @id @default(cuid())
  gameId     String
  game       Game           @relation(fields: [gameId], references: [id])
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  imageUrl   String         @db.VarChar(512)
  imageKey   String         @db.VarChar(255)
  visibility GridVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())
  photos     GridPhoto[]

  likes      GridLike[]
  comments   GridComment[]

  @@unique([gameId, userId])
  @@index([userId])
}

model GridPhoto {
  id           String @id @default(cuid())
  gridId       String
  grid         Grid   @relation(fields: [gridId], references: [id], onDelete: Cascade)
  photoId      String
  photo        Photo  @relation(fields: [photoId], references: [id])
  gridPosition Int

  @@unique([gridId, gridPosition])
}

// ─── MESSAGES DIRECTS ────────────────────────────────────────────────
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(1000)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

// ─── PUSH SUBSCRIPTIONS ──────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

// ─── LIKES & COMMENTAIRES ────────────────────────────────────────────
model GridLike {
  id        String   @id @default(cuid())
  gridId    String
  grid      Grid     @relation(fields: [gridId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gridId, userId])
  @@index([gridId])
}

model GridComment {
  id              String        @id @default(cuid())
  gridId          String
  grid            Grid          @relation(fields: [gridId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String        @db.VarChar(500)
  createdAt       DateTime      @default(now())
  parentCommentId String?
  parentComment   GridComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         GridComment[] @relation("CommentReplies")
  likes           GridCommentLike[]

  @@index([gridId])
  @@index([parentCommentId])
}

model GridCommentLike {
  id        String      @id @default(cuid())
  commentId String
  comment   GridComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────
enum NotificationType {
  FRIEND_REQUEST       // demande d'ami reçue
  FRIEND_ACCEPTED      // ami accepté
  GRID_LIKE            // quelqu'un a liké ta grille
  GRID_COMMENT         // quelqu'un a commenté ta grille
  GRID_COMMENT_REPLY   // quelqu'un a répondu à ton commentaire
  GAME_STARTED         // une partie a démarré
  DM                   // message direct reçu
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?          // qui a déclenché la notif
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  entityId  String?          // gridId, gameId, friendshipId selon le type
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// ─── AMIS ────────────────────────────────────────────────────────────
enum FriendshipStatus {
  PENDING   // demande envoyée, pas encore acceptée
  ACCEPTED  // amis
  DECLINED  // refusée
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId])
}
